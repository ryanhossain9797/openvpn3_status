  <name>OpenVPN 3 Status</name>
  <summary>Monitor and manage OpenVPN 3 profiles and sessions</summary>
  <description>
    <p>A COSMIC applet for monitoring and managing OpenVPN 3 profiles and active sessions. View available profiles, check session status, disconnect active sessions, and delete unused profiles.</p>
    <p>Features:</p>
    <ul>
      <li>View all available OpenVPN 3 profiles</li>
      <li>Monitor active VPN sessions with visual indicators</li>
      <li>Disconnect active sessions with a single click</li>
      <li>Delete unused profiles safely</li>
      <li>Real-time session status updates</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.system76.OpenVPN3Status.desktop</launchable>
